{
  "name": "optdsh-workbench",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "files": [
    "lib",
    "web",
    "config",
    "README.md",
    "NOTICE.md",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "three": "0.186.1",
    "manifold-3d": "3.5.4"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  }
}
