{
  "name": "optdsh",
  "version": "0.2.0-dev.26",
  "private": true,
  "type": "module",
  "description": "Independent optDSH platform and optional optical plugins",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dsh:version": "dsh --version",
    "dsh:help": "dsh --help",
    "test": "node scripts/maintenance/test.mjs",
    "test:quick": "node scripts/maintenance/test.mjs --quick",
    "check": ".venv/Scripts/python.exe scripts/maintenance/check_project.py",
    "test:installation": "node --test tests/installation/*.test.mjs",
    "release:local": "node scripts/maintenance/export-release.mjs",
    "version:show": "node scripts/maintenance/version.mjs show",
    "version:check": "node scripts/maintenance/version.mjs check",
    "version:set": "node scripts/maintenance/version.mjs set",
    "release:check": "node scripts/maintenance/version.mjs release-check"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "manifold-3d": "3.5.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "linkedom": "0.18.13"
  },
  "workspaces": [
    "plugins/optdsh-current-info-policy",
    "packages/optdsh-bundle",
    "packages/optics",
    "packages/ppt-slidewise"
  ]
}
