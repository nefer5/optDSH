      "width": 140,
      "height": 80
    },
    {
      "id": "recover",
      "lane": "failure",
      "col": 2,
      "type": "security",
      "label": "回滚未完成安装",
      "sublabel": "保存诊断与恢复点",
      "width": 140,
      "height": 80
    },
    {
      "id": "fix",
      "lane": "failure",
      "col": 0,
      "type": "external",
      "label": "用户处理缺失条件",
      "sublabel": "不静默换版或豁免",
      "width": 140,
      "height": 80
    }
  ],
  "edges": [
