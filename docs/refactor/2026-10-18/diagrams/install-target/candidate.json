      "id": "choice-check",
      "from": "choice",
      "to": "check",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "check-install",
      "from": "check",
      "to": "packages",
      "label": "满足",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "install-profile",
      "from": "packages",
      "to": "profile",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "profile-workspace",
      "from": "profile",
      "to": "workspace",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "workspace-smoke",
      "from": "workspace",
      "to": "smoke",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "smoke-ready",
      "from": "smoke",
      "to": "ready",
      "label": "通过",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "missing",
      "from": "check",
      "to": "fix",
      "label": "缺失",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "install-fail",
      "from": "packages",
      "to": "recover",
      "label": "失败",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "verify-fail",
      "from": "smoke",
      "to": "recover",
      "label": "未通过",
      "role": "error",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "全部为候选流程",
      "items": [
        "未创建新安装器、未安装组件、未启用Windows功能。",
        "基础平台不因未选择光学功能而要求 Python 或 Zemax。"
      ]
    },
    {
      "dot": "emerald",
      "title": "分层验收",
      "items": [
        "先用 Sandbox 检查干净安装，再用持久 VM 检查升级与恢复。",
        "公司出口、许可证与目标 Zemax 最后在获授权环境验证。"
      ]
    }
  ]
}
