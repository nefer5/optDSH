    ]
  },
  "lanes": [
    {
      "id": "prepare",
      "label": "用户选择与预检"
    },
    {
      "id": "install",
      "label": "安装与第一轮验收"
    },
    {
      "id": "accept",
      "label": "分层确认"
    },
    {
      "id": "failure",
      "label": "失败与恢复",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "release",
    "choice",
    "check",
    "packages",
    "profile",
    "workspace",
    "smoke"
  ],
  "nodes": [
    {
      "id": "release",
      "lane": "prepare",
      "col": 0,
      "type": "external",
      "label": "取得发布包",
      "sublabel": "版本清单 / SHA / 离线说明",
      "width": 140,
      "height": 80
    },
    {
      "id": "choice",
      "lane": "prepare",
      "col": 1,
      "type": "frontend",
      "label": "选择安装能力",
      "sublabel": "纯平台 / 画板 / 光学",
      "width": 140,
      "height": 80
    },
    {
      "id": "check",
      "lane": "prepare",
      "col": 2,
      "type": "security",
      "label": "检查前置条件",
      "sublabel": "只检查所选能力的依赖",
      "width": 140,
      "height": 80
    },
    {
      "id": "packages",
      "lane": "prepare",
      "col": 3,
      "type": "backend",
      "label": "安装独立包",
      "sublabel": "保留用户数据和停用选择",
      "width": 140,
      "height": 80
    },
    {
      "id": "profile",
      "lane": "prepare",
      "col": 4,
      "type": "backend",
      "label": "合并 Profile 组装",
      "sublabel": "登记 bundle / 锁定组合",
      "width": 140,
      "height": 80
    },
    {
      "id": "workspace",
      "lane": "install",
      "col": 4,
      "type": "backend",
      "label": "选择研究目录",
      "sublabel": "安装根 / home / cwd 分开",
      "width": 140,
      "height": 80
    },
    {
      "id": "smoke",
      "lane": "install",
      "col": 5,
      "type": "backend",
      "label": "安装组合冒烟",
      "sublabel": "加载 / UI / synthetic 分层",
      "width": 140,
      "height": 80
    },
    {
      "id": "ready",
      "lane": "accept",
      "col": 5,
      "type": "database",
      "label": "交付检查回执",
